{
  "name": "rental-yield-hunter-ui",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n api,ng -c blue,green \"tsx watch server.ts\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html,scss,css,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.9",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@neondatabase/neon-js": "0.6.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@sparticuz/chromium-min": "^148.0.0",
    "@vercel/blob": "^2.3.3",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "playwright-core": "^1.59.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.3",
    "ng-mocks": "^14.15.2",
    "prettier": "^3.8.1",
    "single-file-cli": "^2.0.83",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "zone.js": "^0.16.1"
  }
}
