{
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/rental-yield-hunter-ui/browser",
  "functions": {
    "api/listings/snapshot.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

